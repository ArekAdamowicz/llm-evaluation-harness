{
  "schema_version": "1.0",
  "dataset_id": "CG-001",
  "dataset_version": "1.0",
  "task_version": "1.2",
  "description": "Calculate arithmetic mean",
  "cases": [
    {
      "id": "CG-001-F01",
      "description": "Standard arithmetic mean",
      "category": "basic_correctness",
      "input": [
        1.0,
        2.0,
        3.0,
        4.0
      ],
      "expected": {
        "type": "numeric",
        "value": 2.5,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F02",
      "description": "Single-element list",
      "category": "basic_correctness",
      "input": [
        42
      ],
      "expected": {
        "type": "numeric",
        "value": 42.0,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F03",
      "description": "Negative numbers",
      "category": "basic_correctness",
      "input": [
        -2.5,
        -7.5
      ],
      "expected": {
        "type": "numeric",
        "value": -5.0,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F04",
      "description": "Integer elements",
      "category": "basic_correctness",
      "input": [
        1,
        2,
        3
      ],
      "expected": {
        "type": "numeric",
        "value": 2.0,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F05",
      "description": "Empty input list",
      "category": "input_validation",
      "input": [],
      "expected": {
        "type": "exception",
        "exception_class": "ValueError",
        "message": "numbers must not be empty"
      }
    },
    {
      "id": "CG-001-F06",
      "description": "Tuple instead of list",
      "category": "input_validation",
      "input": {
        "$type": "tuple",
        "items": [
          1,
          2,
          3
        ]
      },
      "expected": {
        "type": "exception",
        "exception_class": "TypeError",
        "message": "numbers must be a list"
      }
    },
    {
      "id": "CG-001-F07",
      "description": "Invalid element type: string",
      "category": "input_validation",
      "input": [
        1.0,
        "2.0"
      ],
      "expected": {
        "type": "exception",
        "exception_class": "TypeError",
        "message": "all elements must be int or float, excluding bool"
      }
    },
    {
      "id": "CG-001-F08",
      "description": "Boolean elements must be rejected",
      "category": "input_validation",
      "input": [
        true,
        false
      ],
      "expected": {
        "type": "exception",
        "exception_class": "TypeError",
        "message": "all elements must be int or float, excluding bool"
      }
    },
    {
      "id": "CG-001-F09",
      "description": "Validate all element types before numeric conversion",
      "category": "input_validation",
      "input": [
        {
          "$type": "integer",
          "value": ""
        },
        "invalid"
      ],
      "expected": {
        "type": "exception",
        "exception_class": "TypeError",
        "message": "all elements must be int or float, excluding bool"
      }
    },
    {
      "id": "CG-001-F10",
      "description": "NaN value must be rejected",
      "category": "numeric_edge_cases",
      "input": [
        1.0,
        {
          "$type": "float",
          "value": "nan"
        }
      ],
      "expected": {
        "type": "exception",
        "exception_class": "ValueError",
        "message": "numbers must not contain NaN values"
      }
    },
    {
      "id": "CG-001-F11",
      "description": "Positive infinity must be rejected",
      "category": "numeric_edge_cases",
      "input": [
        1.0,
        {
          "$type": "float",
          "value": "inf"
        }
      ],
      "expected": {
        "type": "exception",
        "exception_class": "ValueError",
        "message": "numbers must not contain infinite values"
      }
    },
    {
      "id": "CG-001-F12",
      "description": "Negative infinity must be rejected",
      "category": "numeric_edge_cases",
      "input": [
        1.0,
        {
          "$type": "float",
          "value": "-inf"
        }
      ],
      "expected": {
        "type": "exception",
        "exception_class": "ValueError",
        "message": "numbers must not contain infinite values"
      }
    },
    {
      "id": "CG-001-F13",
      "description": "Numerical precision with cancellation",
      "category": "numeric_stability",
      "input": [
        1e+16,
        1.0,
        -1e+16
      ],
      "expected": {
        "type": "numeric",
        "value": 0.3333333333333333,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F14",
      "description": "Intermediate sum overflow with representable mean",
      "category": "numeric_stability",
      "input": [
        1e+308,
        1e+308
      ],
      "expected": {
        "type": "numeric",
        "value": 1e+308,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F15",
      "description": "Very large integers with cancellation",
      "category": "numeric_stability",
      "input": [
        {
          "$type": "integer",
          "value": ""
        },
        {
          "$type": "integer",
          "value": "-"
        },
        1
      ],
      "expected": {
        "type": "numeric",
        "value": 0.3333333333333333,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F16",
      "description": "Very large integers mixed with floating-point values",
      "category": "numeric_stability",
      "input": [
        {
          "$type": "integer",
          "value": ""
        },
        {
          "$type": "integer",
          "value": "-"
        },
        0.5
      ],
      "expected": {
        "type": "numeric",
        "value": 0.16666666666666666,
        "rel_tol": 1e-09,
        "abs_tol": 1e-12
      }
    },
    {
      "id": "CG-001-F17",
      "description": "Final result exceeds finite float range",
      "category": "overflow_handling",
      "input": [
        {
          "$type": "integer",
          "value": ""
        }
      ],
      "expected": {
        "type": "exception",
        "exception_class": "ValueError",
        "message": "calculation resulted in overflow"
      }
    }
  ]
}
